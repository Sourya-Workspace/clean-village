# ============================================================================
# CleanVillage - Environment Variables Template (.env.example)
# ============================================================================
# Copy this file to ".env" for local development:
#   cp .env.example .env
#
# SECURITY WARNING:
# 1. NEVER commit your real ".env" file to GitHub.
# 2. NEVER expose SUPABASE_SERVICE_ROLE_KEY or ADMIN_PROVISION_PASSWORD
#    with a VITE_ prefix! Any variable starting with VITE_ is bundled into
#    public frontend JavaScript.
# ============================================================================

# --- 1. PUBLIC FRONTEND SUPABASE CONFIGURATION (Safe for Browser & Vercel) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Accepts either a new Supabase publishable key (sb_publishable_...) or legacy anon JWT (eyJ...)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Optional: Force Demo Mode ("true" or "false").
# When VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY are configured, CleanVillage
# automatically connects to your live Supabase backend unless VITE_FORCE_DEMO_MODE=true.
VITE_FORCE_DEMO_MODE=false

# Optional Application Settings
VITE_SLA_TARGET_HOURS=48
VITE_APP_URL=http://localhost:5173

# --- 2. SERVER-SIDE ONLY: ADMINISTRATOR PROVISIONING SCRIPT -----------------
# Used ONLY by `node scripts/provision-admin.mjs` in a trusted terminal.
# Accepts either a new Supabase secret key (sb_secret_...) or legacy service_role JWT (eyJ...).
# DO NOT prefix these with VITE_!
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key-do-not-expose
ADMIN_PROVISION_EMAIL=your-private-admin-email@gmail.com
ADMIN_PROVISION_PASSWORD=your-strong-private-admin-password
ADMIN_PROVISION_FULL_NAME=CleanVillage Sanitation Administrator
